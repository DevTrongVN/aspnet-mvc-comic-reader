@model List<WebTruyenTranh.Models.Truyen>

<h2>Danh sách truyện</h2>
<a href="/Admin/Them">+ Thêm truyện mới</a>
<br />
<a href="/Admin/ThemChap">+Thêm chap mới</a>
<br />
<a href="/Home/Index">Trang chủ</a>
<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <th>Tên truyện</th>
        <th>Tác giả</th>
        <th>Số chap</th>
        <th>Lượt xem</th>
        <th>Tình trạng</th>
        <th>Ảnh bìa</th>
        <th>Hành động</th>
    </tr>

    @foreach (var t in Model)
    {
        <tr>
            <td>@t.TruyenID</td>
            <td>@t.TenTruyen</td>
            <td>@t.IDTacGia</td>
            <td>@t.SOCHAP</td>
            <td>@t.LuotXem</td>
            <td>@t.TinhTrang</td>
            <td><img src="~/Content/AnhBia/@t.AnhBia" width="80" /></td>
            <td>
                <a href="/Admin/Sua/@t.TruyenID">Sửa</a> |
                <form action="/Admin/Xoa" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@t.TruyenID" />
                    <button type="submit" onclick="return confirm('Xóa truyện này?')">Xóa</button>
                </form>
            </td>
        </tr>
    }
</table>