
@model List<WebTruyenTranh.Models.AnhChap>
@using WebTruyenTranh.Models

@{
    ViewBag.Title = "AnhChap";
    Layout = "~/Views/Shared/DangNhap.cshtml";
    var truyen = (Truyen)ViewBag.Truyen;
    var chapHienTai = (Chap)ViewBag.Chap;
    var allChaps = (List<Chap>)ViewBag.AllChaps;
    var prevChap = (Chap)ViewBag.PrevChap;
    var nextChap = (Chap)ViewBag.NextChap;
}

<h2>@truyen.TenTruyen - @chapHienTai.TieuDe</h2>

@foreach (var item in Model)
{
    <div>
        <img src="~/Content/ChapTruyen/@item.LinkAnh" style="width:100%; margin-bottom:10px" />
    </div>
}

<hr />

<div class="navigation-bar" style="text-align: center; margin: 20px 0;">

    @if (prevChap != null)
    {
        @Html.ActionLink("<< Chap Trước", "AnhChap", "Home",
            new { truyenID = truyen.TruyenID, chapID = prevChap.ChapID },
            new { @class = "btn btn-info" })
    }
    else
    {
        <button class="btn btn-info" disabled="disabled">« Chap Trước</button>
    }

    <div class="dropdown" style="display: inline-block;">
        <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownChapList" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            @chapHienTai.TieuDe (Chương @chapHienTai.SoChap)
        </button>
        <div class="dropdown-menu" aria-labelledby="dropdownChapList" style="max-height: 300px; overflow-y: auto;">


            @foreach (Chap c in allChaps)
            {
                <a class="dropdown-item"
                   href="@Url.Action("AnhChap", "Home", new { truyenID = truyen.TruyenID, chapID = c.ChapID })">
                    @c.TieuDe (Chương @c.SoChap)
                </a>
            }
        </div>
    </div>

    @if (nextChap != null)
    {
        @Html.ActionLink("Chap Sau >>", "AnhChap", "Home",
            new { truyenID = truyen.TruyenID, chapID = nextChap.ChapID },
            new { @class = "btn btn-info" })
    }
    else
    {
        <button class="btn btn-info" disabled="disabled">Chap Sau »</button>
    }
</div>

<hr />

<div class="container border border-dark">
    @Html.Action("HienThiBinhLuan", "Home", new { IDTruyen = truyen.TruyenID, IDChap = chapHienTai.ChapID })
</div>